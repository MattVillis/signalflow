{
  "name": "SignalFlow Symbol Desk",
  "short_name": "Symbol Desk",
  "description": "Approve, edit and reject SignalFlow symbol submissions.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAFAF7",
  "theme_color": "#1A1A18",
  "icons": [
